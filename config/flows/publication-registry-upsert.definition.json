{
    "name": "{{FLOW_ID}}",
    "id": "/providers/Microsoft.Flow/flows/{{FLOW_ID}}",
    "type": "Microsoft.Flow/flows",
    "properties": {
        "apiId": "/providers/Microsoft.PowerApps/apis/shared_logicflows",
        "displayName": "CHHHS Research Publications - Daily Ingestion & Enrichment",
        "definition": {
            "metadata": {
                "workflowEntityId": null,
                "processAdvisorMetadata": null,
                "flowChargedByPaygo": null,
                "flowclientsuspensionreason": "None",
                "flowclientsuspensiontime": null,
                "flowclientsuspensionreasondetails": null,
                "creator": {
                    "id": "{{CREATOR_ID}}",
                    "type": "User",
                    "tenantId": "{{TENANT_ID}}"
                },
                "provisioningMethod": "FromDefinition",
                "failureAlertSubscription": true,
                "clientLastModifiedTime": "2026-09-18T00:15:00.0000000Z",
                "lastModifiedBy": "{{CREATOR_ID}}",
                "connectionKeySavedTimeKey": "2026-09-18T00:15:00.0000000Z",
                "creationSource": "Portal",
                "modifiedSources": "Portal"
            },
            "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
            "contentVersion": "undefined",
            "parameters": {
                "$authentication": {
                    "defaultValue": {},
                    "type": "SecureObject"
                },
                "$connections": {
                    "defaultValue": {},
                    "type": "Object"
                }
            },
            "triggers": {
                "Recurrence": {
                    "recurrence": {
                        "frequency": "Day",
                        "interval": 1,
                        "schedule": {
                            "hours": [
                                "20"
                            ],
                            "minutes": [
                                0
                            ]
                        },
                        "timeZone": "UTC"
                    },
                    "type": "Recurrence"
                }
            },
            "actions": {
                "Run_a_query_against_a_dataset": {
                    "runAfter": {},
                    "type": "OpenApiConnection",
                    "inputs": {
                        "parameters": {
                            "groupid": "myworkspace",
                            "datasetid": "{{ISOLATED_MODEL_ID}}",
                            "specification/query": "EVALUATE\nVAR PubMedRows = COALESCE(COUNTROWS(PubMedPublications),0)\nVAR DoraRows = COALESCE(COUNTROWS(DoraPublications),0)\nVAR PubMedAudits = COALESCE(COUNTROWS(PubMedIngestionAudit),0)\nVAR DoraAudits = COALESCE(COUNTROWS(DoraIngestionAudit),0)\nVAR FailedAudits = COALESCE(COUNTROWS(FILTER(PubMedIngestionAudit,NOT(PubMedIngestionAudit[Passed] == TRUE()))),0) + COALESCE(COUNTROWS(FILTER(DoraIngestionAudit,NOT(DoraIngestionAudit[Passed] == TRUE()))),0)\nVAR Ready = PubMedRows > 0 && DoraRows > 0 && PubMedAudits = 9 && DoraAudits = 5 && FailedAudits = 0\nRETURN ROW(\"SourceReadiness\",IF(Ready,\"READY_FOR_STORAGE_VALIDATION\",ERROR(\"INGESTION_NOT_READY: publication tables are empty or required source audits are absent/failing.\")),\"PubMedPublications\",PubMedRows,\"DoraPublications\",DoraRows,\"PubMedAuditRows\",PubMedAudits,\"DoraAuditRows\",DoraAudits,\"FailedAudits\",FailedAudits)",
                            "specification/serializerSettings/includeNulls": true
                        },
                        "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                            "connectionName": "shared_powerbi",
                            "operationId": "ExecuteDatasetQuery"
                        },
                        "authentication": {
                            "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
                            "type": "Raw"
                        }
                    }
                },
                "SharePoint_Get_items": {
                    "runAfter": {
                        "Run_a_query_against_a_dataset": [
                            "Succeeded"
                        ]
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                        "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                            "connectionName": "shared_sharepointonline",
                            "operationId": "GetItems"
                        },
                        "parameters": {
                            "dataset": "{{SHAREPOINT_SITE_URL}}",
                            "table": "{{SHAREPOINT_LIST_ID}}",
                            "$filter": "SourceKey eq '@{item()?['SourceKey']}'",
                            "$top": 1
                        },
                        "authentication": {
                            "type": "Raw",
                            "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
                        }
                    }
                },
                "HTTP_OpenAlex_Enrichment": {
                    "runAfter": {
                        "SharePoint_Get_items": [
                            "Succeeded"
                        ]
                    },
                    "type": "Http",
                    "inputs": {
                        "method": "GET",
                        "uri": "@concat('https://api.openalex.org/works/https://doi.org/', encodeUriComponent(item()?['DOI']), '?mailto={{POLITE_EMAIL}}')",
                        "headers": {
                            "User-Agent": "CHHHS-Research-Registry/1.0 (mailto:{{POLITE_EMAIL}})",
                            "Accept": "application/json"
                        }
                    }
                },
                "Condition_Is_New_Publication": {
                    "runAfter": {
                        "HTTP_OpenAlex_Enrichment": [
                            "Succeeded",
                            "Failed",
                            "Skipped",
                            "TimedOut"
                        ]
                    },
                    "type": "If",
                    "expression": {
                        "equals": [
                            "@length(body('SharePoint_Get_items')?['value'])",
                            0
                        ]
                    },
                    "actions": {
                        "SharePoint_Create_item": {
                            "type": "OpenApiConnection",
                            "inputs": {
                                "host": {
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                    "connectionName": "shared_sharepointonline",
                                    "operationId": "PostItem"
                                },
                                "parameters": {
                                    "dataset": "{{SHAREPOINT_SITE_URL}}",
                                    "table": "{{SHAREPOINT_LIST_ID}}",
                                    "item/Title": "@{item()?['Title']}",
                                    "item/SourceKey": "@{item()?['SourceKey']}",
                                    "item/CanonicalKey": "@{item()?['CanonicalKey']}",
                                    "item/Authors": "@{item()?['Authors']}",
                                    "item/Journal": "@{item()?['Journal']}",
                                    "item/PublicationYear": "@item()?['PublicationYear']",
                                    "item/PublicationMonth": "@{item()?['PublicationMonth']}",
                                    "item/SourceSet": "@{item()?['SourceSet']}",
                                    "item/PMID": "@item()?['PMID']",
                                    "item/DOI": "@{item()?['DOI']}",
                                    "item/PubMedURL": "@{item()?['PubMedURL']}",
                                    "item/DORAURL": "@{item()?['DORAURL']}",
                                    "item/MatchedFacilities": "@{item()?['MatchedFacilities']}",
                                    "item/AttributionEvidence": "@{item()?['AttributionEvidence']}",
                                    "item/ReviewStatus": "Needs Review",
                                    "item/CitationCount_OpenAlex": "@body('HTTP_OpenAlex_Enrichment')?['cited_by_count']",
                                    "item/OpenAccessStatus": "@body('HTTP_OpenAlex_Enrichment')?['open_access']?['oa_status']",
                                    "item/OAUrl": "@body('HTTP_OpenAlex_Enrichment')?['open_access']?['oa_url']",
                                    "item/CitationMetricsObservedUTC": "@{utcNow()}",
                                    "item/FirstObservedUTC": "@{utcNow()}",
                                    "item/LastObservedUTC": "@{utcNow()}"
                                },
                                "authentication": {
                                    "type": "Raw",
                                    "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
                                }
                            }
                        }
                    },
                    "else": {
                        "actions": {
                            "SharePoint_Update_item": {
                                "type": "OpenApiConnection",
                                "inputs": {
                                    "host": {
                                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                        "connectionName": "shared_sharepointonline",
                                        "operationId": "PatchItem"
                                    },
                                    "parameters": {
                                        "dataset": "{{SHAREPOINT_SITE_URL}}",
                                        "table": "{{SHAREPOINT_LIST_ID}}",
                                        "id": "@first(body('SharePoint_Get_items')?['value'])?['Id']",
                                        "item/CitationCount_OpenAlex": "@body('HTTP_OpenAlex_Enrichment')?['cited_by_count']",
                                        "item/OpenAccessStatus": "@body('HTTP_OpenAlex_Enrichment')?['open_access']?['oa_status']",
                                        "item/OAUrl": "@body('HTTP_OpenAlex_Enrichment')?['open_access']?['oa_url']",
                                        "item/CitationMetricsObservedUTC": "@{utcNow()}",
                                        "item/LastObservedUTC": "@{utcNow()}"
                                    },
                                    "authentication": {
                                        "type": "Raw",
                                        "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "connectionReferences": {
            "shared_powerbi": {
                "connectionName": "shared-powerbi-016172d3-dc3c-4514-9c6d-a7bd02cfc4c1",
                "source": "Invoker",
                "id": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                "tier": "NotSpecified",
                "apiName": "powerbi",
                "isProcessSimpleApiReferenceConversionAlreadyDone": false
            },
            "shared_sharepointonline": {
                "connectionName": "shared-sharepointonline",
                "source": "Invoker",
                "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                "tier": "NotSpecified",
                "apiName": "sharepointonline",
                "isProcessSimpleApiReferenceConversionAlreadyDone": false
            }
        },
        "flowFailureAlertSubscribed": false,
        "isManaged": false
    }
}
