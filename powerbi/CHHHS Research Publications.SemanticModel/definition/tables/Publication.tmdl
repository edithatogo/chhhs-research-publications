	measure Publications =
		VAR MatchedKeys = VALUES(PublicationFacility[CanonicalKey])
		VAR FacilityFiltered = ISFILTERED(Facility) || ISFILTERED(PublicationFacility)
		RETURN COALESCE(IF(FacilityFiltered, CALCULATE(DISTINCTCOUNT(Publication[CanonicalKey]), KEEPFILTERS(TREATAS(MatchedKeys, Publication[CanonicalKey]))), DISTINCTCOUNT(Publication[CanonicalKey])), 0)
		formatString: #,0
		lineageTag: 97ff0d7d-3e08-52ff-bdd1-00a5e7eb13ae

	measure 'PubMed Publications' = CALCULATE([Publications], KEEPFILTERS(CONTAINSSTRING(Publication[SourceSet], "PubMed")))
		formatString: #,0
		lineageTag: 29da12a5-24b6-59ce-bdae-142b582758d1

	measure 'DORA Publications' = CALCULATE([Publications], KEEPFILTERS(CONTAINSSTRING(Publication[SourceSet], "DORA")))
		formatString: #,0
		lineageTag: 23eb45e8-8064-50f2-bb53-8a26b2f49b2d

	measure 'Cross-source Matches' = CALCULATE([Publications], KEEPFILTERS(Publication[SourceSet] = "PubMed; DORA"))
		formatString: #,0
		lineageTag: 997e2c79-2289-54df-a7a0-1e2e378b257e

	measure 'DORA-only Publications' = CALCULATE([Publications], KEEPFILTERS(Publication[SourceSet] = "DORA"))
		formatString: #,0
		lineageTag: 7a4074bd-4ba0-5be2-ad45-e4cd635fe502

	measure 'Reconciliation Needs Review' = CALCULATE([Publications], KEEPFILTERS(CONTAINSSTRING(Publication[AttributionStatus], "needs review")))
		formatString: #,0
		lineageTag: 736ad1e8-accb-5cf8-b035-49c0cb269df6

	measure 'Open Access Publications' = CALCULATE([Publications], KEEPFILTERS(Publication[EuropePMC_OpenAccess] = "Y" || Publication[OpenAccessStatus] IN {"Gold", "Green"} || NOT(ISBLANK(Publication[PMCID]))))
		formatString: #,0
		lineageTag: 2088229c-0ca3-5d43-a4ea-be36ab877869

	measure 'Open Access Rate' = DIVIDE([Open Access Publications], [Publications])
		formatString: 0.0%
		lineageTag: 3c6003d0-276d-50a1-bc1e-445f95443e5b

	measure 'Funded Publications' = CALCULATE([Publications], KEEPFILTERS(Publication[FundingType] <> "Unfunded / Departmental" && Publication[FundingType] <> "" && NOT(ISBLANK(Publication[FundingType]))))
		formatString: #,0
		lineageTag: 3b1fe180-2a8a-5612-b643-eb5d6ca7c42f

	measure 'Internal CHHHS Funded Publications' = CALCULATE([Publications], KEEPFILTERS(Publication[IsInternalFunding] = "Yes"))
		formatString: #,0
		lineageTag: ef70c0c7-a7a1-59c1-9ed5-b6f4c7ecb1f2

	measure 'First Nations Health Publications' = CALCULATE([Publications], KEEPFILTERS(Publication[IndigenousHealthFocus] = "Yes"))
		formatString: #,0
		lineageTag: 26b2ce42-edbc-5dad-9906-0a63574f85c9

	measure 'Clinical Trials Count' = CALCULATE([Publications], KEEPFILTERS(Publication[ClinicalTrialID] <> "" && NOT(ISBLANK(Publication[ClinicalTrialID]))))
		formatString: #,0
		lineageTag: e5958ffb-18d5-5dc5-b177-ef8793f37827

	measure 'Archived Full-Text Papers' = CALCULATE([Publications], KEEPFILTERS(Publication[PDFDownloadStatus] IN {"Downloaded", "Already Exists"}))
		formatString: #,0
		lineageTag: 7e4bdfcb-d347-515d-ae81-8fcd9ad74a0e

	measure 'Publications Last Complete Month' =
		VAR StartDate = MAX(ReportingWindow[ReportMonthStart])
		VAR EndDate = MAX(ReportingWindow[ReportMonthEndExclusive])
		RETURN CALCULATE([Publications], REMOVEFILTERS('Date'), DATESBETWEEN('Date'[Date],StartDate,EndDate-1), KEEPFILTERS(Publication[PublicationDatePrecision] IN {"day", "month"}))
		formatString: #,0
		lineageTag: 83c4459f-82fc-51a7-a977-afb5cebf2f01

	measure 'Publications Previous Year Month' =
		VAR StartDate = EDATE(MAX(ReportingWindow[ReportMonthStart]),-12)
		VAR EndDate = EDATE(MAX(ReportingWindow[ReportMonthEndExclusive]),-12)
		RETURN CALCULATE([Publications], REMOVEFILTERS('Date'), DATESBETWEEN('Date'[Date],StartDate,EndDate-1), KEEPFILTERS(Publication[PublicationDatePrecision] IN {"day", "month"}))
		formatString: #,0
		lineageTag: 2bcd0c14-f0aa-517d-8221-6534ac168700

	measure 'Monthly Year-on-Year Change' = DIVIDE([Publications Last Complete Month]-[Publications Previous Year Month], [Publications Previous Year Month])
		formatString: 0.0%;-0.0%
		lineageTag: 5d18b784-ba92-5c43-9d3b-ddc68aca32da

	measure 'Publications Last 24 Complete Months' =
		VAR StartDate = EDATE(MAX(ReportingWindow[ReportMonthEndExclusive]),-24)
		VAR EndDate = MAX(ReportingWindow[ReportMonthEndExclusive])
		RETURN CALCULATE([Publications], KEEPFILTERS(DATESBETWEEN('Date'[Date],StartDate,EndDate-1)))
		formatString: #,0
		lineageTag: 8eb94c27-cead-595d-983d-ae6d0ec58458

	measure 'Publications Without Usable Month' = CALCULATE([Publications], REMOVEFILTERS('Date'), KEEPFILTERS(NOT(Publication[PublicationDatePrecision] IN {"day", "month"})))
		formatString: #,0
		lineageTag: 47f4f80d-6ed7-54b9-ac95-933a5b46d642

	measure 'Reporting Month' = IF(ISFILTERED('Date'[YearMonth]), IF(HASONEVALUE('Date'[YearMonth]), SELECTEDVALUE('Date'[YearMonth]), "Select one month"), FORMAT(MAX(ReportingWindow[ReportMonthStart]), "MMMM yyyy"))
		lineageTag: 1ea03eb1-bc5a-5581-a454-bfd987773d7f

	measure 'Refresh Timestamp UTC' = MAX(ReportingWindow[RefreshedAtUTC])
		formatString: dd MMM yyyy HH:mm "UTC"
		lineageTag: 4b645111-a525-5ea0-b15c-c3a576515500

	measure 'Query Warnings' = COUNTROWS(FILTER(SearchAudit, SearchAudit[Warnings] <> ""))
		formatString: #,0
		lineageTag: 1b8c4ee6-beb6-5413-9011-81df65ee62e2

	measure 'Configured Facility Searches' = COUNTROWS(Facility)
		formatString: #,0
		lineageTag: ed60cd73-cae8-54bf-98df-f99e79650400

	measure 'Register Row Count' = VAR N = [Publications] RETURN IF(N > 0, N, BLANK())
		formatString: #,0
		lineageTag: 84dff746-892e-517d-9770-8537bfad0d2c

	measure 'Selected Month Publications' =
		VAR HasSelection = ISFILTERED('Date'[YearMonth])
		VAR ValidSelection = NOT(HasSelection) || HASONEVALUE('Date'[YearMonth])
		VAR StartDate = IF(HasSelection, DATE(YEAR(MIN('Date'[Date])), MONTH(MIN('Date'[Date])), 1), MAX(ReportingWindow[ReportMonthStart]))
		VAR EndDate = EDATE(StartDate, 1)
		RETURN IF(ValidSelection, CALCULATE([Publications], REMOVEFILTERS('Date'), DATESBETWEEN('Date'[Date], StartDate, EndDate-1), KEEPFILTERS(Publication[PublicationDatePrecision] IN {"day", "month"})), BLANK())
		formatString: #,0
		lineageTag: 421e4556-8d6d-5b5a-a98b-69e4c5bfb15c

	measure 'Monthly Register Row Count' = VAR N = [Selected Month Publications] RETURN IF(N > 0, N, BLANK())
		formatString: #,0
		lineageTag: 318edbdb-ffb9-555c-9f9e-5776ffc4dd92

	partition Publication = m
		mode: import
		source =
			CanonicalPublications[Publications]
