	column RelationshipKey
		dataType: string
		lineageTag: 8f46cec6-f8ae-5287-9ed1-292e2370ee4b
		summarizeBy: none
		sourceColumn: RelationshipKey

	column RelationshipType
		dataType: string
		lineageTag: dc796e92-7dd5-5cfa-a9c7-4b5f075a07e6
		summarizeBy: none
		sourceColumn: RelationshipType

	column FromKey
		dataType: string
		lineageTag: 67d16267-2765-51db-b09e-2ab0a132e866
		summarizeBy: none
		sourceColumn: FromKey

	column ToKey
		dataType: string
		lineageTag: d62a9d29-1a33-5ab1-a76d-5725d0a176aa
