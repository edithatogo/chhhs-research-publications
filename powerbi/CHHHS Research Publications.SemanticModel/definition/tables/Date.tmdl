table Date
	dataCategory: Time
	lineageTag: 428522fe-24ed-545c-909e-ac2267350f34

	column Date
		dataType: dateTime
		formatString: dd MMM yyyy
		isKey
		lineageTag: e7658978-00f1-57a2-bfe4-fdd67db7233f
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		lineageTag: 8de8dcec-c713-5e50-8041-0ebf26ab217c
		summarizeBy: none
		sourceColumn: Year

	column MonthNumber
		dataType: int64
		isHidden
		lineageTag: 857937cd-f296-5575-8fa7-2adc07688c16
		summarizeBy: none
		sourceColumn: MonthNumber

	column MonthName
		dataType: string
		lineageTag: 978750cd-94ee-5753-b3f4-1e1be3d2c522
		summarizeBy: none
		sourceColumn: MonthName
		sortByColumn: MonthNumber

	column YearMonth
		dataType: string
		lineageTag: 2d13567c-12b2-591f-99f7-60fcb456d81f
		summarizeBy: none
		sourceColumn: YearMonth
		sortByColumn: YearMonthSort

	column YearMonthSort
		dataType: int64
		isHidden
		lineageTag: 90aa42d3-020d-5481-ae01-31ee61622b50
		summarizeBy: none
		sourceColumn: YearMonthSort

	partition Date = m
		mode: import
		source =
			let
			    Start = #date(1900,1,1),
			    Finish = #date(Date.Year(Date.From(DateTimeZone.SwitchZone(DateTimeZone.FixedUtcNow(),10)))+2,12,31),
			    Days = List.Dates(Start,Duration.Days(Finish-Start)+1,#duration(1,0,0,0)),
			    A = Table.FromList(Days,Splitter.SplitByNothing(),{"Date"}),
			    B = Table.TransformColumnTypes(A,{{"Date",type date}}),
			    C = Table.AddColumn(B,"Year",each Date.Year([Date]),Int64.Type),
			    D = Table.AddColumn(C,"MonthNumber",each Date.Month([Date]),Int64.Type),
			    E = Table.AddColumn(D,"MonthName",each Date.ToText([Date],"MMM","en-AU"),type text),
			    F = Table.AddColumn(E,"YearMonth",each Date.ToText([Date],"yyyy-MM","en-AU"),type text),
			    G = Table.AddColumn(F,"YearMonthSort",each [Year]*100+[MonthNumber],Int64.Type)
			in G
